generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model QuoteRequest {
  id                        String   @id @default(uuid())
  ticketNumber              String   @unique
  publicStatusToken         String   @unique
  idempotencyKey            String   @unique
  customerName              String
  phoneE164                 String
  location                  String
  serviceType               String
  extrasJson                String   @default("[]")
  notes                     String?
  consentGiven              Boolean
  status                    String   @default("RECEIVED")
  notificationStatus        String   @default("PENDING")
  whatsappCustomerMessageId String?
  whatsappStaffMessageId    String?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  files                     QuoteRequestFile[]
  history                   QuoteRequestStatusHistory[]
  outbox                    OutboxEvent[]
}

model QuoteRequestFile {
  id                    String       @id @default(uuid())
  quoteRequestId        String
  quoteRequest          QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  category              String
  originalNameSanitized String
  storageKey            String
  thumbnailStorageKey   String
  mimeType              String
  sizeBytes             Int
  width                 Int
  height                Int
  sha256                String
  createdAt             DateTime     @default(now())
  @@index([quoteRequestId])
  @@index([sha256])
}

model QuoteRequestStatusHistory {
  id             String       @id @default(uuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  previousStatus String?
  newStatus      String
  actorType      String
  actorId        String?
  note           String?
  createdAt      DateTime     @default(now())
  @@index([quoteRequestId])
}

model OutboxEvent {
  id             String       @id @default(uuid())
  quoteRequestId String
  quoteRequest   QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)
  eventType      String
  payload        String
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @default(now())
  lastError      String?
  createdAt      DateTime     @default(now())
  processedAt    DateTime?
  @@index([status, nextAttemptAt])
}

model AdminSession {
  id        String   @id
  data      String
  expiresAt DateTime
}
