{
  "name": "solima-production",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:styles": "node scripts/consolidate-v2.mjs && node scripts/extract-assets-map.mjs",
    "qa:normal": "node scripts/visual-qa.mjs --motion=normal",
    "qa:reduced": "node scripts/visual-qa.mjs --motion=reduced",
    "qa:merge": "node scripts/merge-visual-results-v2.1.mjs",
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test": "node --test",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:dev": "prisma migrate dev",
    "seed": "node prisma/seed.js",
    "cleanup": "node src/cleanup.js"
  },
  "dependencies": {
    "@prisma/client": "^6.12.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-session": "^1.18.2",
    "file-type": "^21.0.0",
    "helmet": "^8.1.0",
    "libphonenumber-js": "^1.12.10",
    "multer": "^2.0.2",
    "nanoid": "^5.1.5",
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "playwright": "^1.62.0",
    "postcss": "^8.5.23",
    "prisma": "^6.12.0",
    "supertest": "^7.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
